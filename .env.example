# ── Model provider ──────────────────────────────────────────────────────────
# Providers are declared in config.yaml; this file only carries their keys.
# Set the key of the provider you intend to use, and RP_PROVIDER if it is not
# the default. Any OpenAI-compatible endpoint can be added to config.yaml the
# same way, and the model id itself is chosen per run in the wizard.
RP_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=

# A local or self-hosted endpoint (vLLM, Ollama, LM Studio, an internal gateway).
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_API_KEY=

# ── PostgreSQL and S2 retrieval ─────────────────────────────────────────────
# The writer password protects both structured platform state and S2 indexes.
# The distinct read-only account is exposed only to retrieval tools. Compose
# refuses to render without both values and does not publish the database port.
RETRIEVAL_DB_PASSWORD=replace-with-a-long-random-local-password
RETRIEVAL_DB_READER_PASSWORD=replace-with-a-different-random-read-only-password
# Optional override for an externally managed platform PostgreSQL database.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/refactor_platform

# S2 and S3 search with the models named in config.yaml, served by the ollama
# service in the compose file. Its first start pulls several gigabytes of
# weights, during which S2 and S3 runs are refused and everything else works.
# Change a model in config.yaml, not here; that changes the index identity and
# the affected repositories are re-indexed on the next run.
# OLLAMA_HOST=http://ollama:11434

# ── Deployment ──────────────────────────────────────────────────────────────
# Public port for the dashboard (the demo host serves it on 8787).
RP_WEB_PORT=3000
# Interface for the operator dashboard. Loopback is the safe default.
RP_WEB_BIND=127.0.0.1
# Interface the API binds to. Loopback by default; the dashboard reaches it over
# the compose network, so it needs no public port.
RP_API_BIND=127.0.0.1
# Revision reported with the running build, next to the source fingerprint both
# images always report. Optional: set it to the commit you are deploying.
# RP_BUILD_REV=
