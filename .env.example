# ── Model provider: OpenRouter BYOK (recommended) ───────────────────────────
# The platform drives the GitHub Copilot CLI in BYOK mode against an
# OpenAI-compatible endpoint. No GitHub Copilot subscription is required.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# ── GitHub Copilot subscription (alternative to BYOK) ───────────────────────
# Fine-grained PAT with the "Copilot Requests" permission. Leave empty when
# using OpenRouter BYOK above.
COPILOT_GITHUB_TOKEN=

# ── Database (optional) ──────────────────────────────────────────────────────
# Default is SQLite inside the data volume. Point at Postgres to use it instead:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/refactor_platform

# Deployment
# Public port for the dashboard (the demo host serves it on 8787).
RP_WEB_PORT=3000
# Interface the API binds to. Loopback by default; the dashboard reaches it over
# the compose network, so it needs no public port.
RP_API_BIND=127.0.0.1
